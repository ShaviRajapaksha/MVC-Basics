@model LibraryHub.Models.Book

@{
    ViewData["Title"] = "Create Book";
}

<div class="max-w-xl mx-auto px-6 py-10">

    <h1 class="text-3xl font-bold mb-8">
        Add Book
    </h1>

    <form asp-action="Create" method="post" class="space-y-5">

        <div>
            <label asp-for="Title"
                   class="block mb-2 font-medium">
                Title
            </label>

            <input asp-for="Title"
                   class="w-full border rounded-lg px-4 py-2" />
        </div>

        <div>
            <label asp-for="ISBN"
                   class="block mb-2 font-medium">
                ISBN
            </label>

            <input asp-for="ISBN"
                   class="w-full border rounded-lg px-4 py-2" />
        </div>

        <div>
            <label asp-for="PublishedYear"
                   class="block mb-2 font-medium">
                Published Year
            </label>

            <input asp-for="PublishedYear"
                   type="number"
                   class="w-full border rounded-lg px-4 py-2" />
        </div>

        <div>
            <label asp-for="Price"
                   class="block mb-2 font-medium">
                Price
            </label>

            <input asp-for="Price"
                   type="number"
                   step="0.01"
                   class="w-full border rounded-lg px-4 py-2" />
        </div>

        <div>

            <label asp-for="AuthorId"
                   class="block mb-2 font-medium">
                Author
            </label>

            <select asp-for="AuthorId"
                    class="w-full border rounded-lg px-4 py-2">

                <option value="">
                    Select Author
                </option>

                @foreach (var author in ViewBag.Authors)
                {
                    <option value="@author.Id">
                        @author.Name
                    </option>
                }

            </select>

        </div>

        <button type="submit"
                class="bg-blue-600 text-white px-5 py-2 rounded-lg">
            Create
        </button>

        <a asp-action="Index"
           class="bg-gray-300 px-5 py-2 rounded-lg">
            Cancel
        </a>

    </form>

</div>