@model MVC_Basics.Models.Movie

@{
    ViewData["Title"] = "Create Movie";
}

<div class="max-w-xl mx-auto px-6 py-10">

    <h1 class="text-3xl font-bold mb-8">
        Add Movie
    </h1>

    <form asp-action="Create" method="post" class="space-y-5">

        <div>
            <label asp-for="Title" class="block mb-2 font-medium">
                Title
            </label>

            <input asp-for="Title"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2" />

            <span asp-validation-for="Title"
                  class="text-red-500 text-sm">
            </span>
        </div>

        <div>
            <label asp-for="Genre" class="block mb-2 font-medium">
                Genre
            </label>

            <input asp-for="Genre"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2" />

            <span asp-validation-for="Genre"
                  class="text-red-500 text-sm">
            </span>
        </div>

        <div>
            <label asp-for="Price" class="block mb-2 font-medium">
                Price
            </label>

            <input asp-for="Price"
                   type="number"
                   step="0.01"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2" />

            <span asp-validation-for="Price"
                  class="text-red-500 text-sm">
            </span>
        </div>

        <div class="flex gap-3">

            <button type="submit"
                    class="bg-blue-600 text-white px-5 py-2 rounded-lg hover:bg-blue-700">
                Create
            </button>

            <a asp-action="Index"
               class="bg-gray-300 px-5 py-2 rounded-lg hover:bg-gray-400">
                Cancel
            </a>

        </div>

    </form>
</div>