@model IEnumerable<MVC_Basics.Models.Movie>

@{
    ViewData["Title"] = "Movies";
}

<h1>Movies</h1>

<table>
    <thead>
        <tr>
            <th>Title</th>
            <th>Release Date</th>
            <th>Genre</th>
            <th>Price</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Id</td>
                <td>@movie.Title</td>
                <td>@movie.Genre</td>
                <td>@movie.Price</td>
            </tr>
        }
    </tbody>
</table>
