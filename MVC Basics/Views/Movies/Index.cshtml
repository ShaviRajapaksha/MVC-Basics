@model IEnumerable<MVC_Basics.Models.Movie>

@{
    ViewData["Title"] = "Movies";
}

<div class="max-w-6xl mx-auto px-6 py-10">

    <div class="flex items-center justify-between mb-8">

        <div>
            <h1 class="text-3xl font-bold text-gray-900">
                Movies
            </h1>

            <p class="text-gray-600 mt-2">
                Movies stored in PostgreSQL
            </p>
        </div>

        <a asp-controller="Movies"
           asp-action="Create"
           class="bg-blue-600 text-black px-5 py-2 rounded-lg hover:bg-blue-700">
            + Add Movie
        </a>

    </div>

    <div class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow">

        <table class="w-full">

            <thead class="bg-gray-100">

                <tr>

                    <th class="px-6 py-4 text-left">
                        ID
                    </th>

                    <th class="px-6 py-4 text-left">
                        Title
                    </th>

                    <th class="px-6 py-4 text-left">
                        Genre
                    </th>

                    <th class="px-6 py-4 text-left">
                        Price
                    </th>

                    <th class="px-6 py-4 text-left">
                        Actions
                    </th>

                </tr>

            </thead>

            <tbody class="divide-y divide-gray-200">

                @foreach (var movie in Model)
                {
                    <tr class="hover:bg-gray-50">

                        <td class="px-6 py-4">
                            @movie.Id
                        </td>

                        <td class="px-6 py-4 font-medium">
                            @movie.Title
                        </td>

                        <td class="px-6 py-4">
                            @movie.Genre
                        </td>

                        <td class="px-6 py-4">
                            Rs. @movie.Price
                        </td>

                        <td class="px-6 py-4">

                            <div class="flex gap-2">

                                <!-- Edit -->
                                <a asp-controller="Movies"
                                   asp-action="Edit"
                                   asp-route-id="@movie.Id"
                                   class="bg-yellow-500 text-Black px-3 py-1 rounded hover:bg-yellow-600">
                                    Edit
                                </a>

                                <!-- Delete -->
                                <form asp-controller="Movies"
                                      asp-action="Delete"
                                      asp-route-id="@movie.Id"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this movie?');">

                                    <button type="submit"
                                            class="bg-red-600 text-black px-3 py-1 rounded hover:bg-red-700">
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>