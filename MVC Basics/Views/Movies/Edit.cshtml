@model MVC_Basics.Models.Movie

@{
    ViewData["Title"] = "Edit Movie";
}

<div class="max-w-xl mx-auto px-6 py-10">

    <h1 class="text-3xl font-bold mb-8">
        Edit Movie
    </h1>

    <form asp-action="Edit" method="post" class="space-y-5">

        <input type="hidden" asp-for="Id" />

        <div>
            <label asp-for="Title" class="block mb-2 font-medium">
                Title
            </label>

            <input asp-for="Title"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2" />

            <span asp-validation-for="Title"
                  class="text-red-500 text-sm">
            </span>
        </div>

        <div>
            <label asp-for="Genre" class="block mb-2 font-medium">
                Genre
            </label>

            <input asp-for="Genre"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2" />

            <span asp-validation-for="Genre"
                  class="text-red-500 text-sm">
            </span>
        </div>

        <div>
            <label asp-for="Price" class="block mb-2 font-medium">
                Price
            </label>

            <input asp-for="Price"
                   type="number"
                   step="0.01"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2" />

            <span asp-validation-for="Price"
                  class="text-red-500 text-sm">
            </span>
        </div>

        <div class="flex gap-3">

            <button type="submit"
                    class="bg-yellow-500 text-white px-5 py-2 rounded-lg hover:bg-yellow-600">
                Save Changes
            </button>

            <a asp-action="Index"
               class="bg-gray-300 px-5 py-2 rounded-lg hover:bg-gray-400">
                Cancel
            </a>

        </div>

    </form>

</div>